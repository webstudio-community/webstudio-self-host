# Images: pin a tag (e.g. builder:1.2.3) to control upgrades.
BUILDER_IMAGE=ghcr.io/webstudio-community/builder:latest
PUBLISHER_IMAGE=ghcr.io/webstudio-community/webstudio-publisher:latest

# Database
POSTGRES_PASSWORD=change-me-strong-password

# node -e "require('crypto').randomBytes(64).toString('hex')"
PGRST_JWT_SECRET=change-me-64-char-minimum-secret-generate-with-the-command-above

# Authentication: openssl rand -hex 32
AUTH_SECRET=change-me

# OAuth credentials for the webstudio CLI. Any client ID; secret: openssl rand -hex 32
AUTH_WS_CLIENT_ID=self-hosted
AUTH_WS_CLIENT_SECRET=change-me

# Option A: dev login (password = AUTH_SECRET)
DEV_LOGIN=true
DEV_LOGIN_EMAIL=admin@example.com

# Option B: GitHub OAuth app, callback https://<builder-domain>/auth/github/callback
# Comment out DEV_LOGIN when using OAuth.
# GH_CLIENT_ID=
# GH_CLIENT_SECRET=

# Option C: Google OAuth client (web application),
# redirect URI https://<builder-domain>/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Builder public URL, no trailing slash. The app refuses to start when it is empty.
# DEPLOYMENT_URL=https://webstudio.your-domain.com

# Local testing on plain http://localhost only, never in a real deployment:
# __Host- session cookies require HTTPS.
# DEPLOYMENT_ENVIRONMENT=development
# DEPLOYMENT_URL=http://localhost:3000
# ALLOW_INSECURE_COOKIES=true

# Feature flags
FEATURES=*
USER_PLAN=Pro
MAX_ASSETS_PER_PROJECT=50

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-strong-password

# Asset storage: bundled MinIO by default, or any S3-compatible endpoint.
# The keys must match MINIO_ROOT_USER / MINIO_ROOT_PASSWORD when using MinIO.
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=change-me-strong-password
S3_BUCKET=webstudio-assets

# Published sites live at <project>.PUBLISHER_HOST: needs a wildcard DNS record.
# PUBLISHER_HOST=example_domain_test.com

# Publisher ↔ builder token: openssl rand -hex 32
TRPC_SERVER_API_TOKEN=change-mea67a6c147982d021f2a0aa58b5e89238b960ef4719b92f13193fa33

# Publish logs kept per domain.
# PUBLISH_LOG_RETENTION=5

# Optional: "Cloudflare Pages" hosting.
# Token: https://dash.cloudflare.com/profile/api-tokens
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# Optional: "Coolify (remote)" hosting. The publisher pushes site images here
# and the site owner's Coolify pulls them. Needs the docker.sock mount.
# REGISTRY_URL=ghcr.io/my-org
# REGISTRY_USER=
# REGISTRY_TOKEN=

# Published builds kept per project; older ones keep metadata only. 0 = unlimited.
BACKUP_RETENTION=5

SELF_HOSTED_PUBLISHER_URL=http://publisher:4000

# Optional: Entri automatic DNS setup, enabled for every plan. https://entri.com/
# ENTRI_APPLICATION_ID=webstudio
# ENTRI_SECRET=
